{
  "name": "globalauth-desktop",
  "version": "1.0.0",
  "description": "GlobalAuth Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.globalauth.desktop",
    "productName": "GlobalAuth",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "Logo_and_Favicon-removebg-preview.jpg"
    },
    "mac": {
      "target": "dmg",
      "icon": "Logo_and_Favicon-removebg-preview.jpg"
    }
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.0"
  }
}